# =========================
# General
# =========================

.env
.env.*
!.env.example

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store
Thumbs.db
Desktop.ini

# =========================
# IDE / Editor
# =========================

.idea/
.vscode/
*.swp
*.swo

# =========================
# Frontend - Vue / Vite / Node
# =========================

frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/.nuxt/
frontend/.output/
frontend/.cache/
frontend/coverage/

# Local env files inside frontend
frontend/.env
frontend/.env.*
!frontend/.env.example

# =========================
# Backend - Go
# =========================

# Go build output
backend/bin/
backend/tmp/
backend/build/
backend/dist/

# Go binaries
backend/*.exe
backend/*.exe~
backend/*.dll
backend/*.so
backend/*.dylib

# Go test/build artifacts
backend/*.test
backend/*.out
backend/coverage.out

# Air live reload temporary files
backend/tmp/

# Local env files inside backend
backend/.env
backend/.env.*
!backend/.env.example

# =========================
# Optional local database/files
# =========================

*.sqlite
*.sqlite3
*.db

# =========================
# Do NOT ignore these
# =========================

!frontend/package.json
!frontend/package-lock.json
!frontend/pnpm-lock.yaml
!frontend/yarn.lock

!backend/go.mod
!backend/go.sum